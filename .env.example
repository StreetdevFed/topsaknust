NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://topsa:topsa_dev_only@localhost:5432/topsa?schema=public"
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Number of reverse-proxy hops in front of the API (0 locally, usually 1 in production)
TRUST_PROXY=0
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
# Used once by `npm run prisma:seed` to create the first System Administrator (min 12 chars).
# Remove these from the environment after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
